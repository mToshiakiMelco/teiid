<?xml version="1.0" encoding="UTF-8"?>

<persistence version="3.1"
   xmlns="https://jakarta.ee/xml/ns/persistence" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
   xsi:schemaLocation="
        https://jakarta.ee/xml/ns/persistence
        https://jakarta.ee/xml/ns/persistence/persistence_3_1.xsd">
   <persistence-unit name="org.teiid.eclipselink.test"  transaction-type="RESOURCE_LOCAL">

      <class>org.teiid.eclipselink.platform.model.Marketdata</class>

      <properties>
      <property name="jakarta.persistence.jdbc.driver" value="org.teiid.jdbc.TeiidDriver" />
      <property name="jakarta.persistence.jdbc.url" value="jdbc:teiid:Marketdata" />
      <property name="jakarta.persistence.jdbc.user" value="" />
      <property name="jakarta.persistence.jdbc.password" value="" />

      <!-- EclipseLink should create the database schema automatically -->
      <property name="eclipselink.ddl-generation" value="create-tables" />
      <property name="eclipselink.ddl-generation.output-mode" value="database" />
      <!--  -->
      <property name="eclipselink.target-database" value="org.teiid.eclipselink.platform.TeiidPlatform"/>

      <property name="eclipselink.logging.level.sql" value="FINE"/>

    </properties>

   </persistence-unit>
</persistence>
