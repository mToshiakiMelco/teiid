<?xml version="1.0" encoding="UTF-8"?>

<persistence version="3.1"
   xmlns="https://jakarta.ee/xml/ns/persistence" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
   xsi:schemaLocation="
        https://jakarta.ee/xml/ns/persistence
        https://jakarta.ee/xml/ns/persistence/persistence_3_1.xsd">
   <persistence-unit name="org.teiid.translator.jpa.test"  transaction-type="RESOURCE_LOCAL">

      <class>org.teiid.translator.jpa.model.Marketdata</class>
      <class>org.teiid.translator.jpa.model.Stock</class>
      <class>org.teiid.translator.jpa.model.Exchange</class>

      <properties>
      <property name="jakarta.persistence.jdbc.driver" value="org.h2.Driver" />
      <property name="jakarta.persistence.jdbc.url" value="jdbc:h2:mem:" />
      <property name="jakarta.persistence.jdbc.user" value="" />
      <property name="jakarta.persistence.jdbc.password" value="" />
    </properties>

   </persistence-unit>
</persistence>
